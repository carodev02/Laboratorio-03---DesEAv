<Window x:Class="ReservasApp.Views.AulasDataTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aulas - DataTable"
        Height="560"
        Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#F5F1FA">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <StackPanel Margin="0,0,0,25">
            <TextBlock Text="Aulas"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#2F2140"/>

            <TextBlock Text="Listado de aulas usando DataTable"
                       FontSize="14"
                       Foreground="#8A8094"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- TARJETA -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="18"
                Padding="20">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15"
                                  ShadowDepth="2"
                                  Opacity="0.12"/>
            </Border.Effect>

            <DataGrid x:Name="dgAulas"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      RowHeight="38"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="White"
                      Foreground="#34263F"
                      AlternatingRowBackground="#F8F4FB"/>

        </Border>

    </Grid>

</Window>